# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=capm
POSTGRES_PASSWORD=capm_secret
POSTGRES_DB=ca_practice
DATABASE_URL=postgresql://capm:capm_secret@localhost:5432/ca_practice

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@localhost:6379

# ─── JWT (generate with: openssl rand -hex 64) ───────────────────────────────
JWT_SECRET=change_me_jwt_secret_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=change_me_refresh_secret_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Encryption (generate with: openssl rand -hex 32) ────────────────────────
ENCRYPTION_KEY=change_me_32_byte_hex_key_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Storage ─────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=r2   # r2 | s3

# Cloudflare R2
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=ca-practice-docs
R2_PUBLIC_URL=https://your-r2-public-url.r2.dev

# AWS S3 (alternative)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_BUCKET_NAME=ca-practice-docs
AWS_REGION=ap-south-1

# ─── AI ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
AI_MODEL=gpt-4o

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=CA Practice Manager
SMTP_FROM_EMAIL=noreply@your-domain.com

# ─── WhatsApp ────────────────────────────────────────────────────────────────
WHATSAPP_API_KEY=your_whatsapp_api_key
WHATSAPP_API_URL=https://api.whatsapp.com

# ─── Twilio SMS ──────────────────────────────────────────────────────────────
TWILIO_SID=your_twilio_sid
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_FROM=+1234567890

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_NAME=CA Practice Manager

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Session / OTP ───────────────────────────────────────────────────────────
OTP_EXPIRES_IN=300
BCRYPT_ROUNDS=12
